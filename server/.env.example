# pr-gen server 环境变量模板（开源免费版）：复制为 .env 后按需修改
# 不配置任何外部服务密钥时，自动使用本地模拟模式（SQLite + 日志通知）

# --- 基础 ---
APP_NAME=pr-gen
PORT=8000
# DATA_DIR=./server/data

# --- 外部服务（留空 = 本地模拟）---
# SUPABASE_URL=
# SUPABASE_KEY=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- 安全 ---
# 留空则自动生成并持久化到 data/encryption.key（生产请显式配置）
# DATA_ENCRYPTION_KEY=
# 内部 API 密钥：非空时 /api/usage 与 cron 端点要求 X-API-Key 头
# USAGE_API_KEY=

# --- 监控 ---
COST_ALERT_THRESHOLD=5
