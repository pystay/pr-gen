# pr-gen server 环境变量模板：复制为 .env 后按需修改
# 不配置任何外部服务密钥时，自动使用本地模拟模式（SQLite + 邮件落盘 + 日志通知）

# --- 基础 ---
APP_NAME=pr-gen
PORT=8000
# DATA_DIR=./server/data
# MAIL_OUT_DIR=./server/mail_out

# --- GitHub Marketplace Webhook ---
# 生产必须改为强随机值；测试环境默认 dev-webhook-secret
GITHUB_WEBHOOK_SECRET=dev-webhook-secret
# GitHub App 凭证（调用 GitHub API / Marketplace 管理时使用）
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=

# --- 定价（美元）---
PLAN_PRICE_PRO=9
PLAN_PRICE_TEAM=29

# --- 报价公式系数（美元/年）---
QUOTE_BASE_PRICE=99
QUOTE_PER_DEV=12
QUOTE_MIN_DEVS=10
QUOTE_DEPLOYMENT_RATE=0.25
QUOTE_CUSTOM_RATE=0.40
QUOTE_VALID_DAYS=30

# --- 外部服务（留空 = 本地模拟）---
# SUPABASE_URL=
# SUPABASE_KEY=
# RESEND_API_KEY=
# MAIL_FROM=pr-gen <sales@example.com>
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- 安全 ---
# 留空则自动生成并持久化到 data/encryption.key（生产请显式配置）
# DATA_ENCRYPTION_KEY=
# 内部 API 密钥：非空时 /api/usage 与 /api/github/cron/downgrade 要求 X-API-Key 头
# USAGE_API_KEY=

# --- 监控 ---
COST_ALERT_THRESHOLD=5

# --- 国内支付网关（FAST易支付/YPay 风格；留空 = 本地模拟二维码）---
PAY_GATEWAY_URL=
PAY_MERCHANT_ID=
PAY_SECRET_KEY=dev-pay-secret
PAY_CALLBACK_URL=https://your-domain.com/api/payment/callback

# --- PayPal（海外；留空 = 本地模拟 approval URL）---
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_SANDBOX=true

# --- 定价配置（自营订阅渠道；默认 server/config/pricing_config.yaml）---
# PRICING_CONFIG_PATH=
